{
  "expo": {
    "name": "FSDC Flight Reviews",
    "slug": "fsdc",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/AppIcons/playstore.png",
    "scheme": "reviewsapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.ReviewsApp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/AppIcons/playstore.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.ReviewsApp",
      "proguardEnabled": true,
      "enableProguardInReleaseBuilds": true,
      "enableDangerousExperimentalLeanBuilds": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/AppIcons/playstore.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/AppIcons/playstore.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "6ee7f2d9-4656-404a-9aef-e93374d9576f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6ee7f2d9-4656-404a-9aef-e93374d9576f"
    }
  }
}
